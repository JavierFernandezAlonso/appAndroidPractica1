<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#181622"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        app:drawableStartCompat="@drawable/ic_studyplan"
        android:drawablePadding="10dp"
        android:fontFamily="sans-serif-black"
        android:text="@string/studyplan"
        android:textColor="#CDB4FF"
        android:textSize="34sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textView3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/tu_organizador_de_estudios"
        android:textColor="#B8B8C8"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.488"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView2" />

    <Button
        android:id="@+id/btnAsignaturas"
        android:layout_width="280dp"
        android:layout_height="56dp"
        android:layout_marginStart="32dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="32dp"
        android:backgroundTint="#6750A4"
        android:drawableTint="#FFFFFF"
        android:onClick="abrirAsignaturas"
        android:text="@string/mis_asignaturas"
        android:textColor="#FFFFFF"
        app:icon="@drawable/ic_asignaturas"
        app:iconGravity="textStart"
        app:iconTint="#FFFFFF"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutBienvenida" />

    <Button
        android:id="@+id/btnTareasPendientes"
        android:layout_width="280dp"
        android:layout_height="56dp"
        android:layout_marginStart="32dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="32dp"
        android:backgroundTint="#6750A4"
        android:onClick="abrirTareas"
        android:text="@string/tareas_pendientes"
        android:textColor="#FFFFFF"
        app:icon="@drawable/outline_add_task_24"
        app:iconGravity="textStart"
        app:iconTint="#FFFFFF"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnAsignaturas" />

    <Button
        android:id="@+id/btnHorarioDeClases"
        android:layout_width="280dp"
        android:layout_height="56dp"
        android:layout_marginStart="32dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="32dp"
        android:backgroundTint="#6750A4"
        android:onClick="abrirHorarios"
        android:text="@string/horario_de_clases"
        android:textColor="#FFFFFF"
        app:icon="@drawable/outline_avg_time_24"
        app:iconGravity="textStart"
        app:iconTint="#FFFFFF"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnTareasPendientes" />

    <Button
        android:id="@+id/btnCalculadoraDeNotas"
        android:layout_width="280dp"
        android:layout_height="56dp"
        android:layout_marginStart="32dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="32dp"
        android:backgroundTint="#6750A4"
        android:onClick="abrirCalculadora"
        android:text="@string/calculadora_de_notas"
        android:textColor="#FFFFFF"
        app:icon="@drawable/ic_cacluladora"
        app:iconGravity="textStart"
        app:iconTint="#FFFFFF"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnHorarioDeClases" />

    <TextView
        android:id="@+id/textViewMotivacion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        app:drawableStartCompat="@drawable/ic_motivacion"
        android:drawablePadding="8dp"
        app:drawableTint="#CDB4FF"
        android:text="@string/mensaje_motivacion"
        android:textColor="#B8B8C8"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnCalculadoraDeNotas" />

    <LinearLayout
        android:id="@+id/layoutBienvenida"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="32dp"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="@drawable/fondo_bienvenida"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView3">

        <TextView
            android:id="@+id/textViewBienvenida"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/titulo_bienvenida"
            android:textColor="#FFFFFF"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/textViewDescripcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/descripcion_bienvenida"
            android:textColor="#B8B8C8"
            android:textSize="14sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>